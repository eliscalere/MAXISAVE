{
  "manifest_version": 3,
  "name": "Maxisave",
  "version": "1.1.0",
  "description": "Autosaves your Maxient report draft to this browser, restores it after a refresh, and clears it when you submit.",
  "minimum_chrome_version": "88",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://cm.maxient.com/reportingform.php*"],
      "js": ["maxisave.js"],
      "css": ["maxisave.css"],
      "run_at": "document_end"
    }
  ]
}
